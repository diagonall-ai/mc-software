{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "personnal-software",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "app/server.ts",

  // =============================================================================
  // Worker Loader (Dynamic Workers)
  // =============================================================================
  // Required for MCP sandboxed code execution.
  // The LOADER binding lets the app spin up isolated Worker instances at runtime.
  // No auth secrets are passed into the sandbox; tool calls dispatch back to the
  // host via Workers RPC.
  //
  // Reference: https://developers.cloudflare.com/workers/runtime-apis/bindings/worker-loader/
  "worker_loaders": [{ "binding": "LOADER" }],

  // =============================================================================
  // D1 Database
  // =============================================================================
  // Created during bootstrap with:
  //   pnpm wrangler d1 create <app-slug> --binding DB --update-config --config wrangler.jsonc
  // Migrations are generated by Drizzle into `drizzle/migrations` and applied
  // through Wrangler with `--local` or `--remote`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personnal-software",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle/migrations"
    }
  ],

  // =============================================================================
  // Workers AI
  // =============================================================================
  // Models run on Cloudflare only: AI calls fail in local dev (vite.config.ts
  // keeps dev offline) and work once the app is deployed.
  // Reference: https://developers.cloudflare.com/workers-ai/
  "ai": { "binding": "AI" },

  // =============================================================================
  // Durable Objects
  // =============================================================================
  // One `Assistant` (app/agents/assistant.ts) per signed-in user keeps that
  // user's chat. Every class is exported from app/server.ts. To add a class
  // (for example app/worker/rate-limiter.ts), add a binding here and a NEW
  // migration entry with the next tag; never edit a deployed migration.
  // Reference: https://developers.cloudflare.com/durable-objects/
  "durable_objects": {
    "bindings": [{ "name": "Assistant", "class_name": "Assistant" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Assistant"] }]

  // =============================================================================
  // Cron Triggers (Scheduled Events)
  // =============================================================================
  // Uncomment to enable scheduled tasks. Each cron pattern invokes the Worker's
  // `scheduled` event handler (see app/worker/scheduled.ts).
  //
  // After uncommenting, deploy with `wrangler deploy`. Cron triggers only run
  // in production. To test locally:
  //   wrangler dev --test-scheduled
  //   curl "http://localhost:8787/__scheduled?cron=0+*+*+*+*"
  //
  // Cron syntax: minute hour day-of-month month day-of-week
  // Reference: https://developers.cloudflare.com/workers/configuration/cron-triggers/
  //
  // "triggers": {
  //   "crons": [
  //     "0 * * * *",     // Every hour: session cleanup, cache refresh
  //     "0 0 * * *",     // Daily at midnight UTC: data archival, digest prep
  //     "0 9 * * 1",     // Every Monday 9am UTC: weekly report/digest
  //     "*/5 * * * *"    // Every 5 minutes: health checks (use sparingly)
  //   ]
  // },
}
